{
  "manifest_version": 3,
  "name": "Tab Refresh",
  "version": "1.0.0",
  "description": "Auto refresh the current tab on a timer. Set the delay in seconds, press Start, and watch the countdown.",
  "minimum_chrome_version": "120",
  "permissions": ["alarms", "storage"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Tab Refresh",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}
